# Copy this file to .env and fill in your credentials.
AGENT_ROUTER_API_KEY=your_api_key_here
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_ROUTER_MODEL=gpt-6.1-sol

# Optional: comma-separated list of allowed CORS origins. Defaults to "*".
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Optional: maximum number of cached analyses kept in memory.
# CACHE_MAX_ENTRIES=1000

# Optional server settings used by `python main.py`.
# HOST=0.0.0.0
# PORT=8000
